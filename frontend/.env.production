# Public configuration for the production static build (deployed to GitHub Pages
# at policyiq.nz). There is no dev proxy in production, so the app must call the
# backend at its public URL directly. This file is safe to commit - it holds no
# secrets, only the public API origin (see docs/06-DEPLOYMENT-PLAN.md).
VITE_API_BASE_URL=https://api.policyiq.nz/api/v1
