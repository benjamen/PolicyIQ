# PolicyIQ — required environment variables (placeholders only, never real secrets).
# See docs/06-DEPLOYMENT-PLAN.md and docs/10-AUTH-AND-ACCOUNTS.md.

# --- Auth: PolicyIQ-issued JWT sessions ---
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Auth: Microsoft Entra ID SSO (direct OIDC, no third-party IdaaS) ---
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-app-client-id
ENTRA_CLIENT_SECRET=your-entra-app-client-secret
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/entra/callback

# --- CORS (implemented — see backend/app/main.py) ---
# Comma-separated. Defaults to local dev + the GitHub Pages mockup origin + "null" (file://
# testing) if unset, so this is optional for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://benjamen.github.io,null
