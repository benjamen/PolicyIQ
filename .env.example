# PolicyIQ — required environment variables (placeholders only, never real secrets).
# See docs/06-DEPLOYMENT-PLAN.md and docs/10-AUTH-AND-ACCOUNTS.md.

# --- Auth: PolicyIQ-issued JWT sessions ---
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Auth: Microsoft Entra ID SSO (direct OIDC, no third-party IdaaS) ---
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-app-client-id
ENTRA_CLIENT_SECRET=your-entra-app-client-secret
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/entra/callback

# --- LLM extraction provider (implemented — see backend/app/providers/llm.py) ---
# Only consumed by the offline run_ingest.py CLI, never by the running API server
# (compare.py only reads from the database). Unset = extraction is skipped (reported,
# not faked) — get_provider() returns None rather than falling back to a mock.
# LLM_PROVIDER: "groq" or "nvidia" (NVIDIA NIM, integrate.api.nvidia.com — an
# alternative to Groq's free-tier rate limit, see groq-rate-limit-backoff in the
# policyiq-ops wiki). LLM_MODEL defaults per-provider if unset (see get_provider()).
LLM_PROVIDER=groq
LLM_KEY=your-groq-api-key
LLM_MODEL=llama-3.3-70b-versatile
# For LLM_PROVIDER=nvidia instead: LLM_KEY=your-nvidia-nim-api-key (starts nvapi-),
# LLM_MODEL=meta/llama-3.3-70b-instruct (or another NIM-hosted model)

# --- CORS (implemented — see backend/app/main.py) ---
# Comma-separated. Defaults to local dev + the GitHub Pages mockup origin + "null" (file://
# testing) if unset, so this is optional for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://benjamen.github.io,null
